pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    githubPush()
  }

  tools {
    nodejs 'node-20'
  }

  stages {
    stage('Checkout') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
        }
      }
      steps {
        checkout scm
      }
    }

    stage('Build') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
        }
      }
      steps {
        dir('apps/admin') {
          sh 'npm ci'
          sh 'npm run build'
        }
      }
    }

    stage('Deploy') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
        }
      }
      steps {
        sh 'rsync -a --delete apps/admin/dist/ /var/www/admin/'
      }
    }

    stage('Verify') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
        }
      }
      steps {
        sh "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1/login | grep 200"
      }
    }
  }
}
