pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'MP_VERSION', defaultValue: '', description: '留空则使用 package.json version')
    string(name: 'MP_DESC', defaultValue: '', description: '留空则使用最新 Git commit')
    string(name: 'MP_ROBOT', defaultValue: '1', description: '上传机器人 1-30')
  }

  // 无 triggers — 仅手动 Build with Parameters

  tools {
    nodejs 'node-20'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare credentials') {
      steps {
        dir('apps/mobile') {
          withCredentials([file(credentialsId: 'wechat-upload-key', variable: 'WX_KEY')]) {
            sh '''
              cp "$WX_KEY" "private.wxf70d043d359a1586.key"
              chmod 600 private.wxf70d043d359a1586.key
            '''
          }
          sh 'cp env/.env.production.example env/.env.production'
        }
      }
    }

    stage('Upload') {
      steps {
        dir('apps/mobile') {
          sh '''
            ARGS="--robot=${MP_ROBOT}"
            if [ -n "${MP_VERSION}" ]; then ARGS="$ARGS --version=${MP_VERSION}"; fi
            if [ -n "${MP_DESC}" ]; then ARGS="$ARGS --desc=${MP_DESC}"; fi
            pnpm install --frozen-lockfile
            pnpm upload:mp $ARGS
          '''
        }
      }
    }
  }

  post {
    always {
      sh '''
        rm -f apps/mobile/private.wxf70d043d359a1586.key
        rm -f apps/mobile/env/.env.production
      '''
    }
    success {
      echo '上传成功。请登录微信公众平台 → 版本管理 → 选为体验版或提审。'
    }
  }
}
