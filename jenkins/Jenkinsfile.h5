pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    githubPush()
  }

  tools {
    nodejs 'node-20'
  }

  stages {
    stage('Checkout') {
      when {
        anyOf {
          changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
        }
      }
      steps {
        checkout scm
      }
    }

    stage('Prepare env') {
      when {
        anyOf {
          changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
        }
      }
      steps {
        dir('apps/mobile') {
          sh 'cp env/.env.production.example env/.env.production'
        }
      }
    }

    stage('Build') {
      when {
        anyOf {
          changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
        }
      }
      steps {
        dir('apps/mobile') {
          sh 'pnpm install --frozen-lockfile'
          sh 'pnpm build:h5:prod'
        }
      }
    }

    stage('Deploy') {
      when {
        anyOf {
          changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
        }
      }
      steps {
        sh 'rsync -a --delete apps/mobile/dist/build/h5/ /var/www/h5/'
      }
    }

    stage('Verify') {
      when {
        anyOf {
          changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
        }
      }
      steps {
        sh "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1/h5/ | grep -E '200|304'"
      }
    }
  }

  post {
    always {
      sh 'rm -f apps/mobile/env/.env.production'
    }
  }
}
