pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    githubPush()
  }

  when {
    anyOf {
      changeset pattern: 'apps/mobile/.*', comparator: 'REGEXP'
      changeset pattern: 'jenkins/Jenkinsfile.h5', comparator: 'REGEXP'
    }
  }

  tools {
    nodejs 'node-20'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare env') {
      steps {
        dir('apps/mobile') {
          sh '''
            cp env/.env.production.example env/.env.production
            # 若 Jenkins 配置了 Credential file 'mobile-env-production'，可改为：
            # withCredentials([file(credentialsId: 'mobile-env-production', variable: 'ENV_FILE')]) {
            #   cp "$ENV_FILE" env/.env.production
            # }
          '''
        }
      }
    }

    stage('Build') {
      steps {
        dir('apps/mobile') {
          sh 'pnpm install --frozen-lockfile'
          sh 'pnpm build:h5:prod'
        }
      }
    }

    stage('Deploy') {
      steps {
        sh 'rsync -a --delete apps/mobile/dist/build/h5/ /var/www/h5/'
      }
    }

    stage('Verify') {
      steps {
        sh "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1/h5/ | grep -E '200|304'"
      }
    }
  }

  post {
    always {
      sh 'rm -f apps/mobile/env/.env.production'
    }
  }
}
