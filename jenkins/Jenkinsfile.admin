pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    githubPush()
  }

  environment {
    PATH = "/usr/local/bin:/usr/bin:${env.PATH}"
    npm_config_cache = '/var/lib/jenkins/.npm'
    npm_config_audit = 'false'
    npm_config_fund = 'false'
    npm_config_prefer_offline = 'true'
  }

  stages {
    stage('Build') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        dir('apps/admin') {
          sh '''
            set -eu
            mkdir -p "$npm_config_cache"
            LOCK_HASH=$(sha256sum package-lock.json | awk '{print $1}')
            if [ -d node_modules ] && [ -f .ci-lock-hash ] && [ "$(cat .ci-lock-hash)" = "$LOCK_HASH" ]; then
              echo "package-lock.json unchanged, skip npm ci"
            else
              npm ci --no-audit --no-fund --prefer-offline
              echo "$LOCK_HASH" > .ci-lock-hash
            fi
            npx vite build
          '''
        }
      }
    }

    stage('Deploy') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        sh 'rsync -a --delete apps/admin/dist/ /var/www/admin/'
      }
    }

    stage('Verify') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        sh "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1/login | grep 200"
      }
    }
  }
}
