pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 12, unit: 'MINUTES')
  }

  triggers {
    githubPush()
  }

  environment {
    PATH = "/usr/local/bin:/usr/bin:${env.PATH}"
    npm_config_cache = '/var/lib/jenkins/.npm'
    npm_config_audit = 'false'
    npm_config_fund = 'false'
    npm_config_prefer_offline = 'true'
    NODE_OPTIONS = '--max-old-space-size=384'
  }

  stages {
    stage('Build') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        dir('apps/admin') {
          sh '''
            set -eu
            mkdir -p "$npm_config_cache"
            LOCK_HASH=$(sha256sum package-lock.json | awk '{print $1}')
            if [ -d node_modules ] && [ -f .ci-lock-hash ] && [ "$(cat .ci-lock-hash)" = "$LOCK_HASH" ]; then
              echo "package-lock.json unchanged, skip npm ci"
            else
              npm ci --no-audit --no-fund --prefer-offline
              echo "$LOCK_HASH" > .ci-lock-hash
            fi
            npx vite build
          '''
        }
      }
    }

    stage('Deploy') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        sh 'rsync -a --delete apps/admin/dist/ /var/www/admin/'
      }
    }

    stage('Verify') {
      when {
        anyOf {
          changeset pattern: 'apps/admin/.*', comparator: 'REGEXP'
          changeset pattern: 'jenkins/Jenkinsfile.admin', comparator: 'REGEXP'
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        sh '''
          set -eu
          LOGIN_CODE=$(curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1/login)
          [ "$LOGIN_CODE" = "200" ]
          curl -sf 'http://127.0.0.1/auth/login' -X POST \
            -H 'Content-Type: application/json' \
            -H 'Clientid: e5cd7e4891bf95d1d19206ce24a7b32e' \
            -d '{"clientId":"e5cd7e4891bf95d1d19206ce24a7b32e","grantType":"password","username":"admin","password":"invalid"}' \
            | grep -q '"code":'
          curl -sf 'http://127.0.0.1/special/mobile/resource/list?pageNum=1&pageSize=1' | grep -q '"code":200'
        '''
      }
    }
  }
}
